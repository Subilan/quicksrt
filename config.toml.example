# quicksrt 配置示例：复制为 config.toml 并填写实际值。
# 密钥一律走环境变量（见 .env.example），不要写在这里。

[project]
work_dir = "work"
output_dir = "dist"

[download]
# yt-dlp 格式选择：最佳视频+最佳音频，自动合并
format = "bv*+ba/b"
# 从浏览器读取 cookies（绕过反爬）；留空则不用
cookies_from_browser = "chrome"
# 远程组件（JS challenge solver）；留空则不用
remote_components = "ejs:github"

[asr]
# 阿里云百炼 非实时语音识别（Qwen3-ASR-Flash-Filetrans，异步）
provider = "aliyun"
model = "qwen3-asr-flash-filetrans"
region = "cn-beijing"
# endpoint 留空时自动拼接为 https://{DASHSCOPE_WORKSPACE_ID}.{region}.maas.aliyuncs.com/api/v1
endpoint = ""
# 源语言（本链路为英文 -> 简体中文）
language = "en"
enable_words = true
enable_itn = false
poll_interval = 5
poll_timeout = 7200

[oss]
bucket = "your-bucket-name"
endpoint = "oss-cn-beijing.aliyuncs.com"
upload_prefix = "audio"
presign_days = 7

[translate]
provider = "deepseek"
base_url = "https://api.deepseek.com"
model = "deepseek-chat"
temperature = 0.3
batch_max_chars = 3000
max_retries = 3

[srt]
max_line_chars = 42
max_lines = 2
max_duration = 7.0
min_duration = 0.5

[style]
# libass 烧录样式（ASS 风格）
font_name = "Noto Sans CJK SC"
font_size_ratio = 0.05
margin_v_ratio = 0.05
primary_color = "&H00FFFFFF"
outline_color = "&H00000000"
outline = 2
shadow = 1

[burn]
# 留空则按源编码器自动选择（libx264/libx265/libsvtav1）
encoder = ""
# 留空则用各编码器默认（libx264: crf 18/slow，libx265: crf 22/medium，svt-av1: crf 30/preset 8）；
# 设置后对所有编码器生效（注意 svt-av1 的 preset 只接受数字 0-13）
crf = ""
preset = ""
